{
  "name": "ops-mcp",
  "version": "1.0.0",
  "description": "Seminar Demo 5: an ops MCP server (customers, orders, policy KB, tickets) over Streamable HTTP",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "inspector": "npx -y @modelcontextprotocol/inspector",
    "test": "node scripts/smoke-test.js",
    "reset-tickets": "node -e \"require('fs').writeFileSync('data/tickets.json','[]')\"",
    "test:modern": "node scripts/smoke-test.js --modern"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0"
  }
}
