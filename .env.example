# Shared settings for all seminar demos. Copy to .env (never commit .env).

# --- LLM provider: OpenRouter -------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-...
# Fast, cheap model for classification (D1, D2). Check exact IDs at https://openrouter.ai/models
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
# Stronger model for tool-using agents (D3)
OPENROUTER_AGENT_MODEL=anthropic/claude-sonnet-5.5

# Optional: price in USD per million tokens of OPENROUTER_MODEL, to show cost in the demos
PRICE_IN_PER_MTOK=
PRICE_OUT_PER_MTOK=

# --- Ops MCP server (D5) ------------------------------------------------
MCP_PORT=3200
# Any long random string. Clients send it as: Authorization: Bearer <MCP_TOKEN>
MCP_TOKEN=change-me-to-a-long-random-string
# Hosts the MCP server accepts. A leading dot allows a whole domain (only for the Demo 9 tunnel — remove afterwards).
# MCP_ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal,.trycloudflare.com

# --- Demo 9 only: Anthropic MCP connector (not available through OpenRouter) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# https tunnel to the ops MCP server, e.g. https://<random>.trycloudflare.com/mcp
MCP_PUBLIC_URL=

# --- Demo 7 only: token from n8n Settings → n8n MCP (used by Cursor's config) ---
N8N_MCP_TOKEN=
